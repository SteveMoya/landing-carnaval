---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="flex min-h-[80svh] flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-8xl uppercase tracking-tight text-pink">404</p>
    <h1 class="mt-4 font-display text-5xl uppercase tracking-tight">
      Esto fue un <span class="text-yellow">caos</span> total
    </h1>
    <p class="mt-3 max-w-md font-body text-paper/70">
      La página que buscas no existe o se movió. Ni nosotros sabemos dónde está.
    </p>
    <Button href="/" class="mt-8">Volver al inicio</Button>
  </section>
</BaseLayout>
