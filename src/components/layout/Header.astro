---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="container-carnaval flex h-16 items-center justify-between md:h-20">
    <Logo />

    <Navigation class="hidden lg:flex" />

    <div class="flex items-center gap-3">
      <Button href={`mailto:${site.email}`} size="sm" class="hidden sm:inline-flex">
        <Icon name="mail" size={14} />
        {site.hero.primaryCta}
      </Button>
      <button
        data-menu-button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center border-2 border-paper text-paper transition-colors hover:bg-paper hover:text-black lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<style>
  [data-header] {
    background: transparent;
  }
</style>

<script>
  import { initHeader } from '../../scripts/header';

  initHeader();
</script>
