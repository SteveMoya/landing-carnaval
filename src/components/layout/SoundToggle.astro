---
import Icon from '../ui/Icon.astro';
---

<button
  data-sound-toggle
  type="button"
  aria-pressed="false"
  aria-label="Activar sonido de la experiencia"
  title="Sonido"
  class="fixed bottom-5 right-5 z-50 inline-flex h-11 w-11 items-center justify-center border-2 border-black bg-paper text-black shadow-black transition-all duration-200 hover:-translate-y-0.5 hover:shadow-pink"
>
  <Icon name="volume" size={18} class="icon-volume" />
  <Icon name="volume-off" size={18} class="icon-volume-off" />
</button>

<script>
  import { initSound } from '../../scripts/sound';

  initSound();
</script>
