---
import { gallery } from '../../data/gallery';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
---

<Section id="trabajo" ariaLabelledBy="gallery-title" background="paper">
  <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
    <div>
      <p class="mb-3 font-accent text-xs uppercase tracking-[0.3em] text-blue">Trabajo reciente</p>
      <h2
        id="gallery-title"
        class="font-display text-5xl uppercase leading-[0.95] tracking-tight text-black sm:text-6xl"
      >
        El caos que <span class="text-pink">recordamos</span>
      </h2>
    </div>
    <p class="max-w-md font-body text-black/70">
      Una muestra de lo que pasa cuando el briefing dice "sorpréndenos".
    </p>
  </div>

  <ul class="grid auto-rows-[180px] grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      gallery.map((item, index) => (
        <li
          data-reveal
          style={`--reveal-delay:${(index % 3) * 70}ms`}
          class:list={[
            item.span === 'wide' && 'sm:col-span-2',
            item.span === 'tall' && 'sm:row-span-2',
          ]}
        >
          <Card
            tone={item.tone}
            rotate={index % 2 === 0 ? -1.5 : 1.5}
            class="flex h-full flex-col justify-between overflow-hidden hover:rotate-0 hover:shadow-black"
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-display text-2xl uppercase leading-tight tracking-tight">
                {item.title}
              </h3>
              <span class="font-accent text-xs">{item.year}</span>
            </div>
            <p class="font-body text-sm font-semibold uppercase tracking-wide opacity-70">
              {item.category}
            </p>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>
