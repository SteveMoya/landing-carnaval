---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<Section>
  <div class="noise relative overflow-hidden border-4 border-black bg-pink px-6 py-24 text-center shadow-[10px_10px_0_var(--color-yellow)] sm:px-16">
    <!-- confeti decorativo -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <span class="absolute left-8 top-10 h-4 w-4 -rotate-12 bg-yellow"></span>
      <span class="absolute right-12 top-16 h-5 w-5 rotate-45 bg-blue"></span>
      <span class="absolute bottom-12 left-16 h-6 w-6 rotate-12 bg-gold"></span>
      <span class="absolute bottom-16 right-24 h-4 w-4 -rotate-6 bg-black"></span>
      <span class="absolute left-1/3 top-6 h-3 w-3 rotate-90 bg-blue"></span>
    </div>

    <div class="relative">
      <h2 class="font-display text-6xl uppercase leading-[0.92] tracking-tight text-black sm:text-7xl md:text-8xl">
        ¿Listo para el <span class="text-yellow">caos</span>?
      </h2>
      <p class="mx-auto mt-6 max-w-xl font-body text-lg leading-relaxed text-black/80">
        Cuéntanos tu evento y te devolvemos una propuesta en 72 horas. Sin compromiso, con mucha actitud.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href={`mailto:${site.email}?subject=Quiero%20una%20propuesta`} size="lg" data-sound>
          Pedir propuesta
          <Icon name="zap" size={18} />
        </Button>
        <Button href="#trabajo" variant="ghost" size="lg" data-sound>
          Ver el trabajo
        </Button>
      </div>
    </div>
  </div>
</Section>
